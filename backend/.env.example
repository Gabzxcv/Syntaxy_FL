# Copy this file to .env and fill in your values
# Never commit .env to version control

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# JWT secret key (generate separately)
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database URL — PostgreSQL is recommended for both development and production.
# Install a local PostgreSQL server and create a database, then set the URL below.
# Example local:      postgresql://user:password@localhost:5432/syntaxy
# Example Render:     (set DATABASE_URL in the Render dashboard; it is auto-populated)
# SQLite fallback for quick local testing (not recommended for production):
#   DATABASE_URL=sqlite:///code_clone_detector.db
DATABASE_URL=postgresql://user:password@localhost:5432/syntaxy

# Flask environment: development | production
FLASK_ENV=development

# Enable Werkzeug debug reloader (development only, never true in production)
FLASK_DEBUG=false
