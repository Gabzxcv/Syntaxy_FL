# Copy this file to .env and fill in your values
# Never commit .env to version control

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# JWT secret key (generate separately)
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database URL (defaults to SQLite for development)
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/syntaxy
DATABASE_URL=sqlite:///code_clone_detector.db

# Flask environment: development | production
FLASK_ENV=development

# Enable Werkzeug debug reloader (development only, never true in production)
FLASK_DEBUG=false
